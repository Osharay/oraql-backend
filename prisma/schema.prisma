// ─── Oracle Database Schema ───
// PostgreSQL via Railway, managed by Prisma ORM

generator client {
  provider      = "prisma-client-js"
  // linux-musl-openssl-3.0.x: required for the node:20-alpine runtime image
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ════════════════════════════════════════════
// USERS & AUTH
// ════════════════════════════════════════════

enum AuthProvider {
  EMAIL
  GOOGLE
  APPLE
}

enum UserRole {
  USER
  PREMIUM
  ADMIN
}

model User {
  id            String       @id @default(uuid())
  email         String       @unique
  passwordHash  String?      // null for SSO-only users
  firstName     String?
  lastName      String?
  avatarUrl     String?
  role          UserRole     @default(USER)
  authProvider  AuthProvider  @default(EMAIL)
  providerId    String?      // external provider user id
  emailVerified Boolean      @default(false)
  isActive      Boolean      @default(true)

  // Preferences
  preferredSports  Sport[]   @default([FOOTBALL])
  timezone         String    @default("UTC")

  // Tokens
  refreshToken     String?

  // Billing: the free trial runs to trialEndsAt (null = sign-up + the trial
  // length); a paid period runs to subscriptionEndsAt.
  trialEndsAt        DateTime?
  subscriptionEndsAt DateTime?

  // Relations
  payments          Payment[]
  builderSelections BuilderSelection[]
  activityLogs      UserActivityLog[]
  customClusters    CustomCluster[]

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([email])
  @@index([authProvider, providerId])
  @@map("users")
}

model UserActivityLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String   // e.g. "view_event", "add_to_builder", "export_selections"
  metadata  Json?    // flexible payload for action-specific data
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("user_activity_logs")
}

// ════════════════════════════════════════════
// SPORTS, LEAGUES, TEAMS
// ════════════════════════════════════════════

enum Sport {
  FOOTBALL
  BASKETBALL
  TENNIS
  CRICKET
  BASEBALL
  HOCKEY
}

/// The competitions OraQL covers on purpose.
///
/// Coverage used to follow whatever fixtures happened to arrive, which meant
/// history for U19 leagues and Romanian third divisions and none for the
/// leagues people bet. This table is the decision: what we hold, how deep,
/// and in what order to fetch it. Editable without a deploy, because the
/// client will add and drop competitions as his audience changes.
model TargetCompetition {
  id           String   @id @default(uuid())
  /// API-Football league id, resolved from name + country at seed time.
  externalId   String?  @unique
  name         String
  country      String?
  /// 1 = deepest history, 2 = standard, 3 = cups and international.
  tier         Int      @default(2)
  /// Seasons of fixtures to hold. Observations are windowed separately.
  seasons      Int      @default(4)
  isActive     Boolean  @default(true)
  /// Set when the provider's league list confirmed the id.
  resolvedAt   DateTime?
  /// Last time coverage completed a backfill pass for this competition.
  coveredAt    DateTime?
  note         String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isActive, tier])
  @@map("target_competitions")
}

model League {
  id              String   @id @default(uuid())
  externalId      String   @unique  // API-Football league id
  name            String
  country         String?
  countryCode     String?
  sport           Sport    @default(FOOTBALL)
  season          Int      // e.g. 2025
  logoUrl         String?
  isActive        Boolean  @default(true)

  events          Event[]
  observations    MarketObservation[]
  baselines       MarketBaseline[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([sport, isActive])
  @@index([externalId])
  @@map("leagues")
}

model Team {
  id              String   @id @default(uuid())
  externalId      String   @unique  // API-Football team id
  name            String
  shortName       String?
  logoUrl         String?
  country         String?
  sport           Sport    @default(FOOTBALL)
  venueCity       String?
  venueName       String?

  /// Elo rating from results (RatingsService). Null until rated.
  rating          Float?
  ratingMatches   Int?
  /// STRONG / AVERAGE / WEAK: third of its league by rating.
  ratingTier      String?
  /// The league the tier is measured within.
  ratingLeagueId  String?
  ratedAt         DateTime?
  /// When the squad's season numbers were last pulled.
  playerStatsAt   DateTime?

  // Relations
  homeEvents      Event[]  @relation("HomeTeam")
  awayEvents      Event[]  @relation("AwayTeam")
  players         Player[]
  matchStats      MatchStats[]
  observations    MarketObservation[]
  marketProfiles  TeamMarketProfile[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([externalId])
  @@index([sport])
  @@map("teams")
}

model Player {
  id              String   @id @default(uuid())
  externalId      String   @unique
  name            String
  position        String?  // GK, DEF, MID, FWD
  number          Int?
  photoUrl        String?
  teamId          String
  team            Team     @relation(fields: [teamId], references: [id])
  isActive        Boolean  @default(true)

  /// Season numbers for his current club (AvailabilityRefreshService).
  seasonGoals     Int?
  seasonAssists   Int?
  seasonApps      Int?
  seasonMinutes   Int?
  seasonShots     Int?
  statsSeason     Int?
  statsAt         DateTime?

  injuries        PlayerInjury[]
  lineupEntries   LineupEntry[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([teamId])
  @@index([externalId])
  @@map("players")
}

// ════════════════════════════════════════════
// EVENTS (MATCHES / FIXTURES)
// ════════════════════════════════════════════

enum EventStatus {
  SCHEDULED     // fixture confirmed, not started
  LINEUP_CONFIRMED // lineups announced
  LIVE          // match in progress
  HALF_TIME     // half-time break
  FINISHED      // full time
  POSTPONED     // postponed
  CANCELLED     // cancelled
  SUSPENDED     // suspended during play
}

model Event {
  id              String       @id @default(uuid())
  externalId      String       @unique  // API-Football fixture id
  leagueId        String
  league          League       @relation(fields: [leagueId], references: [id])
  homeTeamId      String
  homeTeam        Team         @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeamId      String
  awayTeam        Team         @relation("AwayTeam", fields: [awayTeamId], references: [id])
  sport           Sport        @default(FOOTBALL)
  status          EventStatus  @default(SCHEDULED)
  kickoffAt       DateTime
  venue           String?
  round           String?      // e.g. "Regular Season - 15"
  /// The provider's season for this fixture (2025 = 2025/26 in Europe).
  /// Leagues store a single season, so this is the only per-match one.
  season          Int?

  // Scores (updated live)
  homeScore       Int?
  awayScore       Int?
  htHomeScore     Int?        // half-time
  htAwayScore     Int?
  ftHomeScore     Int?        // full-time
  ftAwayScore     Int?

  // Relations
  matchStats      MatchStats[]
  markets         Market[]
  picks           Pick[]
  lineups         Lineup[]
  odds            BookmakerOdds[]
  observations    MarketObservation[]
  streakSnapshots StreakSnapshot[]
  pickResults     PickResult[]
  customClusterLegs CustomClusterLeg[]

  // Timestamps
  lineupsConfirmedAt DateTime?
  lastDataSync       DateTime?

  /// What this event's observations were derived from — registry hash plus
  /// which inputs (stats, half-time, score) were present. Re-derived only when
  /// it no longer matches. See streaks/derive-signature.ts.
  derivedSignature   String?

  /// Each side's rating going into the match, for splitting records by
  /// opponent strength.
  homeRatingBefore   Float?
  awayRatingBefore   Float?

  /// When this fixture's injuries and suspensions were last checked.
  absencesCheckedAt  DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([kickoffAt])
  @@index([sport, kickoffAt])
  @@index([status, kickoffAt])
  @@index([leagueId, kickoffAt])
  @@index([homeTeamId])
  @@index([awayTeamId])
  @@index([externalId])
  @@map("events")
}

// ════════════════════════════════════════════
// MATCH STATISTICS (Historical Data)
// ════════════════════════════════════════════

model MatchStats {
  id              String   @id @default(uuid())
  eventId         String
  event           Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  teamId          String
  team            Team     @relation(fields: [teamId], references: [id])

  // Core stats
  goals           Int      @default(0)
  shotsTotal      Int?
  shotsOnTarget   Int?
  possession      Float?   // percentage 0-100
  corners         Int      @default(0)
  yellowCards     Int      @default(0)
  redCards        Int      @default(0)
  fouls           Int?
  offsides        Int?
  saves           Int?

  // Advanced
  expectedGoals   Float?   // xG if available
  passAccuracy    Float?   // percentage
  totalPasses     Int?

  createdAt       DateTime @default(now())

  @@unique([eventId, teamId])
  @@index([teamId, createdAt])
  @@index([eventId])
  @@map("match_stats")
}

// ════════════════════════════════════════════
// LINEUPS & INJURIES
// ════════════════════════════════════════════

model Lineup {
  id              String        @id @default(uuid())
  eventId         String
  event           Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  teamId          String
  formation       String?       // e.g. "4-3-3"
  isConfirmed     Boolean       @default(false)

  entries         LineupEntry[]

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([eventId, teamId])
  @@map("lineups")
}

model LineupEntry {
  id              String   @id @default(uuid())
  lineupId        String
  lineup          Lineup   @relation(fields: [lineupId], references: [id], onDelete: Cascade)
  playerId        String
  player          Player   @relation(fields: [playerId], references: [id])
  position        String?  // specific position in formation
  gridPosition    String?  // e.g. "1:4" for formation grid
  isStarter       Boolean  @default(true)

  @@unique([lineupId, playerId])
  @@map("lineup_entries")
}

model PlayerInjury {
  id              String   @id @default(uuid())
  playerId        String
  player          Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  type            String   // e.g. "Hamstring", "Knee", "Suspended"
  reason          String?
  status          String   // "Out", "Doubtful", "Day-to-Day"
  startDate       DateTime?
  expectedReturn  DateTime?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([playerId])
  @@map("player_injuries")
}

// ════════════════════════════════════════════
// BETTING MARKETS & PROBABILITIES
// ════════════════════════════════════════════

enum MarketCategory {
  MATCH_RESULT     // 1X2
  GOALS            // Over/Under, BTTS
  CORNERS          // Over/Under corners
  CARDS            // Over/Under cards
  PLAYER           // Player-specific props
  HALFTIME         // HT result, HT/FT
  HANDICAP         // Asian handicap
  SPECIAL          // Other markets
}

model Market {
  id                  String          @id @default(uuid())
  eventId             String
  event               Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  category            MarketCategory
  name                String          // e.g. "Over 2.5 Goals", "BTTS Yes"
  /// MODEL: the probability model's own (rebuilt on recompute). STREAK:
  /// created from a streak or cluster for a Bet Builder; never removed by it.
  origin              String          @default("MODEL")
  shortName           String?         // e.g. "O2.5", "BTTS"
  line                Float?          // e.g. 2.5 for Over 2.5

  // Oracle's computed probability
  probability         Float           // 0.0 to 1.0
  confidence          Float           @default(0.5) // 0.0 to 1.0 (how confident in the calc)
  probabilityUpdatedAt DateTime       @default(now())

  // Value bet detection
  impliedProbability  Float?          // from bookmaker odds
  valueGap            Float?          // oracle prob - implied prob
  isValueBet          Boolean         @default(false)

  // Explanation
  explanation         String?         @db.Text
  explanationFactors  Json?           // structured: { stats: [], injuries: [], context: [] }

  // Relations
  picks               Pick[]
  builderSelections   BuilderSelection[]

  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@index([eventId, category])
  @@index([eventId, probability(sort: Desc)])
  @@index([isValueBet])
  @@map("markets")
}

// ════════════════════════════════════════════
// ORACLE PICKS (Ranked Top Predictions)
// ════════════════════════════════════════════

model Pick {
  id              String   @id @default(uuid())
  eventId         String
  event           Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  marketId        String
  market          Market   @relation(fields: [marketId], references: [id], onDelete: Cascade)
  rank            Int      // 1 = highest probability pick for this event
  probability     Float    // snapshot at time of pick generation
  confidence      Float    @default(0.5)
  explanation     String?  @db.Text  // human-readable summary
  isActive        Boolean  @default(true)

  // Tracking
  computedAt      DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([eventId, rank])
  @@index([eventId, isActive])
  @@index([probability(sort: Desc)])
  @@map("picks")
}

// ════════════════════════════════════════════
// BOOKMAKER ODDS
// ════════════════════════════════════════════

model BookmakerOdds {
  id              String   @id @default(uuid())
  eventId         String
  event           Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  bookmaker       String   // e.g. "bet365", "william_hill"
  marketName      String   // e.g. "Over 2.5 Goals"
  selection       String   // e.g. "Over", "Under", "Home", "Draw", "Away"
  odds            Float    // decimal odds
  impliedProb     Float    // 1 / odds

  fetchedAt       DateTime @default(now())
  createdAt       DateTime @default(now())

  @@index([eventId, marketName])
  @@index([eventId, bookmaker])
  @@map("bookmaker_odds")
}

// ════════════════════════════════════════════
// BET BUILDER (User Selections)
// ════════════════════════════════════════════

model BuilderSelection {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  marketId        String
  market          Market   @relation(fields: [marketId], references: [id], onDelete: Cascade)
  addedProbability Float   // probability at time of adding to builder
  /// Where it was added from: STREAK_EVIDENCE, STREAK_EMERGING,
  /// STREAK_EXPLORATORY, CLUSTER, MATCH_FORM, or null for a match-page market.
  source          String?
  /// For a streak selection: its market definition and side, so a saved
  /// cluster can settle it from observations when the model has no market.
  streakMarketId  String?
  streakSide      String?

  createdAt       DateTime @default(now())

  @@unique([userId, marketId])
  @@index([userId])
  @@map("builder_selections")
}

// ════════════════════════════════════════════
// DATA INGESTION TRACKING
// ════════════════════════════════════════════

enum IngestJobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  PARTIAL
}

model IngestJob {
  id              String          @id @default(uuid())
  provider        String          // "api_football", "odds_api"
  jobType         String          // "daily_fixtures", "lineup_poll", "odds_refresh", "stats_backfill"
  status          IngestJobStatus @default(QUEUED)
  recordsProcessed Int            @default(0)
  recordsFailed    Int            @default(0)
  errorMessage    String?         @db.Text
  metadata        Json?           // job-specific context
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime        @default(now())

  @@index([provider, jobType, createdAt])
  @@index([status])
  @@map("ingest_jobs")
}

// ════════════════════════════════════════════
// V2 — STREAK ENGINE
// Append-only observation history, baselines, and the candidates
// derived from them. Nothing here writes to Market or Pick: those
// remain the per-event computed view.
// ════════════════════════════════════════════

enum ObservationResult {
  WIN
  LOSS
  VOID
  UNKNOWN
}

enum ObservationSelection {
  HOME
  AWAY
  MATCH
}

enum DataQuality {
  OK
  PARTIAL
  SUSPECT
}

enum StreakStatus {
  NEW
  ACTIVE
  STRENGTHENING
  WEAKENING
  BROKEN
  EXPIRED
  FILTERED
}

enum StreakEntityType {
  TEAM
  LEAGUE
  MATCHUP
}

enum ProfileFlag {
  WATCH
  NEUTRAL
  CAUTION
}

/// Declarative registry of every market the engine can evaluate.
/// Win conditions live in code (see market-definitions.ts); this table
/// carries display metadata and the on/off switch.
model MarketDefinition {
  id            String         @id @default(uuid())
  marketId      String         @unique // e.g. "TEAM_OVER_0_5"
  displayName   String
  shortName     String?
  category      MarketCategory
  line          Float?
  /// Which sides this market can be evaluated for.
  selections    ObservationSelection[]
  /// Stat fields the evaluator needs; missing ones produce UNKNOWN.
  requires      String[]
  /// Per-market override of the sample floor. Null uses the engine default.
  /// Markets differ in base rate and volatility, so the evidence needed to
  /// distinguish one from its baseline differs too.
  minSample     Int?
  isActive      Boolean        @default(true)
  notes         String?

  observations  MarketObservation[]
  baselines     MarketBaseline[]
  candidates    StreakCandidate[]
  profiles      TeamMarketProfile[]

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([isActive])
  @@map("market_definitions")
}

/// One settled market outcome for one event. Append-only: corrections
/// arrive as a new row pointing at the one they supersede.
model MarketObservation {
  id                 String              @id @default(uuid())
  eventId            String
  event              Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  marketDefinitionId String
  marketDefinition   MarketDefinition    @relation(fields: [marketDefinitionId], references: [id])

  selection          ObservationSelection
  line               Float?
  result             ObservationResult

  /// Denormalised for query speed — streak slices filter on these constantly.
  leagueId           String
  league             League              @relation(fields: [leagueId], references: [id])
  season             Int
  teamId             String?
  team               Team?               @relation(fields: [teamId], references: [id])
  isHome             Boolean?
  kickoffAt          DateTime

  oddsAtSettlement   Float?
  impliedProbability Float?
  dataQuality        DataQuality         @default(OK)

  /// Append-only: a correction inserts revision 2 rather than editing revision 1,
  /// so re-running derivation is idempotent and history is never rewritten.
  revision           Int                 @default(1)

  settledAt          DateTime            @default(now())
  createdAt          DateTime            @default(now())

  @@unique([eventId, marketDefinitionId, selection, revision])
  @@index([marketDefinitionId, leagueId, season])
  @@index([teamId, marketDefinitionId, kickoffAt(sort: Desc)])
  @@index([kickoffAt])
  @@map("market_observations")
}

/// Expected hit rate for a market in a league and season. The number that
/// turns a raw hit rate into lift.
model MarketBaseline {
  id                 String           @id @default(uuid())
  marketDefinitionId String
  marketDefinition   MarketDefinition @relation(fields: [marketDefinitionId], references: [id])
  leagueId           String?
  league             League?          @relation(fields: [leagueId], references: [id])
  season             Int?

  sampleSize         Int
  wins               Int
  baselineRate       Float

  computedAt         DateTime         @default(now())

  @@unique([marketDefinitionId, leagueId, season])
  @@index([marketDefinitionId])
  @@map("market_baselines")
}

/// One tested slice from one engine run. Most candidates never reach a user;
/// they are kept so the multiple-comparisons correction has a denominator.
model StreakCandidate {
  id                 String           @id @default(uuid())
  engineRunId        String
  engineRun          EngineRun        @relation(fields: [engineRunId], references: [id], onDelete: Cascade)

  entityType         StreakEntityType
  entityId           String
  marketDefinitionId String
  marketDefinition   MarketDefinition @relation(fields: [marketDefinitionId], references: [id])
  /// Null when the slice is venue-agnostic: the side is resolved per fixture
  /// at snapshot time, because "this team, any venue" has no fixed selection.
  selection          ObservationSelection?
  /// Slice context, e.g. { "venue": "ALL" }
  context            Json?

  sampleSize         Int
  wins               Int
  hitRate            Float
  baselineRate       Float
  lift               Float
  pValue             Float?
  adjustedPValue     Float?

  currentStreak      Int              @default(0)
  longestStreak      Int              @default(0)
  last10             String?          // e.g. "WWLWWWWLWW"

  strengthScore      Float            @default(0)
  status             StreakStatus     @default(NEW)
  survivedGate       Boolean          @default(false)

  snapshots          StreakSnapshot[]

  createdAt          DateTime         @default(now())

  @@index([engineRunId, survivedGate])
  @@index([marketDefinitionId, lift(sort: Desc)])
  @@index([entityType, entityId])
  @@map("streak_candidates")
}

/// Immutable record of what was shown, captured before kickoff.
/// Without the cutoff, post-match information leaks into evaluation.
model StreakSnapshot {
  id                 String            @id @default(uuid())
  streakCandidateId  String
  streakCandidate    StreakCandidate   @relation(fields: [streakCandidateId], references: [id], onDelete: Cascade)
  eventId            String
  event              Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)

  capturedAt         DateTime          @default(now())
  dataCutoffAt       DateTime
  kickoffAt          DateTime

  hitRate            Float
  baselineRate       Float
  lift               Float
  sampleSize         Int
  currentStreak      Int
  strengthScore      Float

  oddsAtCapture      Float?
  impliedProbability Float?
  edge               Float?

  displayedRank      Int?
  wasDisplayed       Boolean           @default(false)

  result             SnapshotResult?
  clusterComponents  ClusterComponent[]

  @@index([eventId])
  @@index([kickoffAt])
  @@index([wasDisplayed, kickoffAt])
  @@map("streak_snapshots")
}

/// Settlement of a snapshot — the other half of the feedback loop.
model SnapshotResult {
  id                  String            @id @default(uuid())
  snapshotId          String            @unique
  snapshot            StreakSnapshot    @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  result              ObservationResult
  brokeStreakAtLength Int?
  realisedLift        Float?
  failureNotes        String?

  settledAt           DateTime          @default(now())

  @@index([result, settledAt])
  @@map("snapshot_results")
}

/// Derived behaviour per team per market. Never hand-curated.
model TeamMarketProfile {
  id                 String           @id @default(uuid())
  teamId             String
  team               Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  marketDefinitionId String
  marketDefinition   MarketDefinition @relation(fields: [marketDefinitionId], references: [id])

  sampleSize         Int
  wins               Int
  hitRate            Float
  baselineRate       Float
  lift               Float
  /// Spread of per-window hit rate around this team's own mean.
  variance           Float?
  flag               ProfileFlag      @default(NEUTRAL)

  lastComputedAt     DateTime         @default(now())

  @@unique([teamId, marketDefinitionId])
  @@index([flag])
  @@map("team_market_profiles")
}

/// One execution of the streak engine. candidatesTested is what the
/// multiple-comparisons correction divides by, so it counts every slice
/// tested including those discarded.
model EngineRun {
  id                   String            @id @default(uuid())
  startedAt            DateTime          @default(now())
  completedAt          DateTime?

  eventsScanned        Int               @default(0)
  observationsCreated  Int               @default(0)
  candidatesTested     Int               @default(0)
  candidatesSurviving  Int               @default(0)
  clustersCreated      Int               @default(0)

  errors               String?
  warnings             String?

  candidates           StreakCandidate[]
  clusters             Cluster[]

  @@index([startedAt])
  @@map("engine_runs")
}

model Cluster {
  id                  String             @id @default(uuid())
  engineRunId         String?
  engineRun           EngineRun?         @relation(fields: [engineRunId], references: [id])
  date                DateTime
  type                String             @default("DAILY_STRONGEST")
  componentCount      Int
  /// Product of component probabilities — shown with the same weight as the
  /// component count, so a four-fold is not mistaken for four certainties.
  combinedProbability Float
  status              StreakStatus       @default(NEW)

  components          ClusterComponent[]

  createdAt           DateTime           @default(now())

  @@index([date])
  @@map("clusters")
}

model ClusterComponent {
  id         String         @id @default(uuid())
  clusterId  String
  cluster    Cluster        @relation(fields: [clusterId], references: [id], onDelete: Cascade)
  snapshotId String
  snapshot   StreakSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  rank       Int
  /// The chance this selection was built into the cluster with; null on
  /// clusters built before 9 Oct 2026, which used the raw record.
  chance     Float?

  @@unique([clusterId, snapshotId])
  @@map("cluster_components")
}

/// How each OraQL pick settled, copied from the pick at kickoff so the record
/// survives picks being regenerated. Written by PicksService.settleFinished.
model PickResult {
  id          String            @id @default(uuid())
  eventId     String
  event       Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  marketName  String
  category    String
  rank        Int
  probability Float
  kickoffAt   DateTime
  /// When the pick was made. Only picks made before kickoff count on the record.
  pickedAt    DateTime?
  result      ObservationResult
  settledAt   DateTime          @default(now())

  @@unique([eventId, marketName])
  @@index([kickoffAt])
  @@map("pick_results")
}

/// A cluster a user put together from the Bet Builder and saved, to see how
/// it would have gone without placing it. Locked once saved: the selections
/// are copied, and it can only be deleted before its first match starts.
model CustomCluster {
  id                  String             @id @default(uuid())
  userId              String
  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                String?
  legCount            Int
  /// The builder's combined chance; null when selections share a match, and
  /// the range is the answer.
  combinedProbability Float?
  combinedLow         Float
  combinedHigh        Float
  firstKickoffAt      DateTime
  lastKickoffAt       DateTime
  legs                CustomClusterLeg[]
  createdAt           DateTime           @default(now())

  @@index([userId, createdAt])
  @@map("custom_clusters")
}

model CustomClusterLeg {
  id             String             @id @default(uuid())
  clusterId      String
  cluster        CustomCluster      @relation(fields: [clusterId], references: [id], onDelete: Cascade)
  eventId        String
  event          Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  rank           Int
  marketName     String
  category       String
  /// MODEL or STREAK, as on the market it was copied from.
  origin         String
  source         String?
  streakMarketId String?
  streakSide     String?
  probability    Float
  kickoffAt      DateTime
  result         ObservationResult?
  settledAt      DateTime?

  @@index([clusterId])
  @@index([eventId])
  @@index([result, kickoffAt])
  @@map("custom_cluster_legs")
}

/// Prices, trial length and the paywall switch, edited from Engine controls.
/// One row, id "default".
model BillingSettings {
  id             String   @id @default("default")
  /// Whole naira.
  dailyPrice     Int      @default(200)
  monthlyPrice   Int      @default(5000)
  quarterlyPrice Int      @default(10000)
  trialDays      Int      @default(2)
  paywallEnabled Boolean  @default(true)
  currency       String   @default("NGN")
  updatedAt      DateTime @updatedAt

  @@map("billing_settings")
}

/// One checkout. Paid once only: fulfilment moves PENDING to PAID atomically,
/// so a webhook and the return page arriving together extend access once.
model Payment {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// FLUTTERWAVE or BACHS.
  provider    String
  /// MONTHLY or QUARTERLY.
  plan        String
  /// Whole naira, as charged.
  amount      Int
  currency    String
  periodDays  Int
  /// Ours, sent to the provider (Flutterwave tx_ref, Bachs reference).
  reference   String    @unique
  /// The provider's own id (Flutterwave transaction id, Bachs checkout id).
  providerRef String?
  /// PENDING, PAID or FAILED.
  status      String    @default("PENDING")
  paidAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("payments")
}

/// What people tell us about OraQL, from the feedback button.
model Feedback {
  id        String   @id @default(uuid())
  /// POSITIVE or NEGATIVE.
  sentiment String
  message   String?
  email     String?
  userId    String?
  page      String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("feedback")
}
