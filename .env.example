# ─── Oracle API Environment Variables ───
# Copy this file to .env and fill in your values

# ─── Application ───
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:3000

# ─── Database (PostgreSQL) ───
DATABASE_URL=postgresql://oracle:oracle_dev@localhost:5432/oracle_db?schema=public

# ─── Redis ───
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── JWT Auth ───
JWT_SECRET=your-super-secret-jwt-key-change-this
# Separate key for refresh tokens (recommended; derived from JWT_SECRET if unset)
JWT_REFRESH_SECRET=a-different-long-random-secret
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=30d

# ─── Google OAuth ───
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback

# ─── Cloudflare R2 Storage ───
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=oracle-assets
R2_PUBLIC_URL=

# ─── Data Providers ───
API_FOOTBALL_KEY=
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
ODDS_API_KEY=
ODDS_API_BASE_URL=https://api.the-odds-api.com/v4

# ─── Rate Limiting ───
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# ─── Sentry (Error Tracking) ───
SENTRY_DSN=
